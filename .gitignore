# Generated dataset (reproducible from data/ + the documented seed; ~20MB)
data/out/

# Training runs and checkpoints (the browser demo ships the quantized export instead)
runs/
*.pt

node_modules/
.venv/
__pycache__/
*.pyc

web/dist/

# The quantized browser model IS committed: the demo is the deliverable, and a fresh clone
# cannot rebuild it without first regenerating the dataset and retraining. Everything else
# generated stays out of git.
web/weights/*.onnx
!web/weights/model.int8.onnx
!web/weights/.gitkeep

.DS_Store

# Training logs kept at the repo root during runs
runs_*.log
