# Generated dataset (reproducible from data/ + the documented seed; ~20MB)
data/out/

# Training runs and checkpoints
runs/
*.pt

node_modules/
.venv/
__pycache__/
*.pyc

# Build outputs. src/weights.generated.ts is the inlined model, written by scripts/build.mjs.
dist/
demo/dist/
src/weights.generated.ts

# The exported browser model IS committed: a fresh clone cannot rebuild it without first
# regenerating the dataset and retraining. Only the intermediate ONNX exports stay out.
weights/*.onnx

.DS_Store

# Run logs kept at the repo root during runs (training and eval)
runs_*.log
eval_*.log
test/gpu-bundle.js*

# Superseded: the demo reads the raw export, not an ONNX graph
weights/*.onnx
